<Window x:Class="BcuHolo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BCU Holo" Width="1440" Height="900" MinWidth="900" MinHeight="600"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Rail -->
        <Border Background="{StaticResource Rail}" BorderBrush="{StaticResource RowLine}" BorderThickness="0,0,1,0" Padding="18,28">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,0,0,30">
                    <Grid Width="28" Height="28">
                        <Ellipse Stroke="{StaticResource Accent}" StrokeThickness="2.5" StrokeDashArray="7.5 2.5"/>
                        <Ellipse Width="8" Height="8" Fill="{StaticResource Accent}"/>
                    </Grid>
                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontFamily="{StaticResource Display}" FontSize="18" FontWeight="Bold">
                        <Run Text="BCU"/><Run Text="/" Foreground="{StaticResource Accent}"/><Run Text="HOLO"/>
                    </TextBlock>
                </StackPanel>
                <Border DockPanel.Dock="Top" CornerRadius="10" Background="{StaticResource AccentSoft}" BorderBrush="#4D3DDCFF" BorderThickness="1" Height="44" Padding="12,0">
                    <TextBlock Text="Apps" VerticalAlignment="Center"/>
                </Border>
                <Button x:Name="RescanButton" DockPanel.Dock="Bottom" Style="{StaticResource Ghost}" Content="Rescan" Click="Rescan_Click"/>
            </DockPanel>
        </Border>

        <!-- Main -->
        <Grid Grid.Column="1" Margin="32,28,32,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Overview cards -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="132" Height="132">
                            <Ellipse Stroke="{StaticResource Track}" StrokeThickness="12"/>
                            <!-- Dash units are multiples of StrokeThickness; set from code -->
                            <Ellipse x:Name="DriveRing" Stroke="{StaticResource Accent}" StrokeThickness="12"
                                     StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform><RotateTransform Angle="-90"/></Ellipse.RenderTransform>
                                <Ellipse.Effect><DropShadowEffect Color="#3DDCFF" BlurRadius="18" ShadowDepth="0" Opacity="0.55"/></Ellipse.Effect>
                            </Ellipse>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="DrivePct" Text="—" FontFamily="{StaticResource Display}" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock Text="used" Foreground="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel Margin="24,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="DriveLabel" Style="{StaticResource Caps}" Text="Local disk C:"/>
                            <TextBlock Margin="0,4,0,4" FontFamily="{StaticResource Display}" FontSize="34" FontWeight="Bold">
                                <Run x:Name="DriveFree" Text="—"/><Run Text=" free" FontSize="16" FontWeight="Normal" Foreground="{StaticResource Muted}"/>
                            </TextBlock>
                            <TextBlock x:Name="DriveUsed" FontFamily="{StaticResource Mono}" FontSize="13" Foreground="{StaticResource Muted}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="SplitTitle" Style="{StaticResource Caps}" Text="Where the used space went"/>
                        <Grid Height="14" Margin="0,14,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="SplitApps" Width="1*"/>
                                <ColumnDefinition Width="3"/>
                                <ColumnDefinition x:Name="SplitOther" Width="2*"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="{StaticResource Accent}" CornerRadius="7,0,0,7"/>
                            <Border Grid.Column="2" Background="{StaticResource Other}" CornerRadius="0,7,7,0"/>
                        </Grid>
                        <WrapPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
                                <Border Width="10" Height="10" CornerRadius="3" Background="{StaticResource Accent}" Margin="0,0,8,0"/>
                                <TextBlock>Installed apps <Run x:Name="AppsTotal" FontFamily="{StaticResource Mono}" FontWeight="Bold" Text="—"/></TextBlock>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="10" Height="10" CornerRadius="3" Background="{StaticResource Other}" BorderBrush="#6B7FA0" BorderThickness="1" Margin="0,0,8,0"/>
                                <TextBlock>Files, caches, WSL <Run x:Name="OtherTotal" FontFamily="{StaticResource Mono}" FontWeight="Bold" Text="—"/></TextBlock>
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Toolbar -->
            <DockPanel Grid.Row="1" Margin="0,0,0,14">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Border CornerRadius="12" Background="#0DFFFFFF" BorderBrush="{StaticResource PanelLine}" BorderThickness="1" Width="280" Height="44" Padding="14,0">
                        <Grid>
                            <TextBlock x:Name="SearchHint" Text="Search apps, publishers…" Foreground="{StaticResource Muted}" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Text}" CaretBrush="{StaticResource Accent}"
                                     VerticalAlignment="Center" FontSize="14" TextChanged="Search_Changed" AutomationProperties.Name="Search apps"/>
                        </Grid>
                    </Border>
                    <RadioButton x:Name="FilterAll" Style="{StaticResource Chip}" Content="All" IsChecked="True" GroupName="f" Checked="Filter_Changed"/>
                    <RadioButton x:Name="FilterLarge" Style="{StaticResource Chip}" Content="Over 1 GB" GroupName="f" Checked="Filter_Changed"/>
                    <RadioButton x:Name="FilterMs" Style="{StaticResource Chip}" Content="Microsoft" GroupName="f" Checked="Filter_Changed"/>
                    <RadioButton x:Name="FilterStore" Style="{StaticResource Chip}" Content="Store apps" GroupName="f" Checked="Filter_Changed"/>
                </StackPanel>
                <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource Display}" FontSize="26" FontWeight="Bold">
                    Installed apps <Run x:Name="ListCaption" FontSize="15" FontWeight="Normal" Foreground="{StaticResource Muted}" Text="· sorted by size"/>
                </TextBlock>
            </DockPanel>

            <!-- List -->
            <Border Grid.Row="2" CornerRadius="18,18,0,0" Background="#06FFFFFF" BorderBrush="{StaticResource RowLine}" BorderThickness="1,1,1,0">
                <ListBox x:Name="AppList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Text}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel" SelectionMode="Single" KeyDown="List_KeyDown"
                         AutomationProperties.Name="Installed apps">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="r" Background="Transparent" BorderBrush="{StaticResource RowLine}" BorderThickness="0,0,0,1">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="r" Property="Background" Value="#0F3DDCFF"/>
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter TargetName="r" Property="Background" Value="{StaticResource DangerSoft}"/>
                                            </DataTrigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="r" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                                <Setter TargetName="r" Property="BorderThickness" Value="1"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="60" Margin="20,0" Background="Transparent" MouseLeftButtonUp="Row_Click">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="54"/>
                                    <ColumnDefinition Width="2.2*"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="1.6*"/>
                                    <ColumnDefinition Width="96"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" Focusable="False"
                                          AutomationProperties.Name="{Binding Name, StringFormat=Select {0}}"/>
                                <Border Grid.Column="1" Width="40" Height="40" CornerRadius="11" Background="{StaticResource Tile}" BorderBrush="#403DDCFF" BorderThickness="1" HorizontalAlignment="Left">
                                    <Grid>
                                        <TextBlock x:Name="ini" Visibility="Collapsed" Text="{Binding Initials}" FontFamily="{StaticResource Display}" FontWeight="Bold" Foreground="{StaticResource Accent}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Image Source="{Binding Icon}" Width="24" Height="24"/>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,14,0">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Publisher}" Foreground="{StaticResource Muted}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Border Grid.Column="3" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="999" Background="#0FFFFFFF" Padding="10,4">
                                    <TextBlock Text="{Binding Kind}" FontSize="12" Foreground="#C5D3E8"/>
                                </Border>
                                <Grid Grid.Column="4" Height="8" VerticalAlignment="Center" Margin="0,0,14,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding BarFill}"/>
                                        <ColumnDefinition Width="{Binding BarRest}"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.ColumnSpan="2" CornerRadius="4" Background="{StaticResource Track}"/>
                                    <Border x:Name="bar" CornerRadius="4" Background="{StaticResource Accent}"/>
                                </Grid>
                                <TextBlock Grid.Column="5" Text="{Binding SizeText}" FontFamily="{StaticResource Mono}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                    <Setter TargetName="ini" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="bar" Property="Background" Value="{StaticResource Danger}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Scan progress -->
            <Border x:Name="ScanOverlay" Grid.Row="2" Background="#E6070B14" CornerRadius="18,18,0,0">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="420">
                    <TextBlock Text="Scanning installed apps…" FontFamily="{StaticResource Display}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <ProgressBar x:Name="ScanProgress" Height="4" Margin="0,18,0,10" Foreground="{StaticResource Accent}" Background="{StaticResource Track}" BorderThickness="0" IsIndeterminate="True"/>
                    <TextBlock x:Name="ScanStatus" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>

            <!-- Selection bar -->
            <Border x:Name="SelectionBar" Grid.Row="2" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,22"
                    Background="#EB0E1628" BorderBrush="#593DDCFF" BorderThickness="1" CornerRadius="18" Padding="24,14,16,14" Visibility="Collapsed">
                <Border.Effect><DropShadowEffect Color="Black" BlurRadius="40" ShadowDepth="10" Opacity="0.6"/></Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="SelCount" VerticalAlignment="Center" FontSize="15"/>
                    <TextBlock VerticalAlignment="Center" Margin="20,0" FontFamily="{StaticResource Display}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Accent}">
                        <Run x:Name="SelSize"/><Run Text=" reclaimable" FontSize="14" FontWeight="Normal" Foreground="{StaticResource Muted}"/>
                    </TextBlock>
                    <Button Style="{StaticResource Ghost}" Content="Clear" Click="Clear_Click" Margin="0,0,10,0"/>
                    <Button x:Name="UninstallButton" Style="{StaticResource Primary}" IsEnabled="False"
                            ToolTipService.ShowOnDisabled="True" ToolTip="Uninstall wiring is the next build step"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
