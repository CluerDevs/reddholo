<Window x:Class="BcuHolo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BCU Holo" Width="1440" Height="900" MinWidth="980" MinHeight="620"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
    <!-- Custom dark chrome: our own caption bar + buttons, native resize/snap kept -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#14FFFFFF"/>
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#C42B1C"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Frame" BorderBrush="{StaticResource PanelLine}" BorderThickness="1">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Rail (spans the caption row; empty areas drag the window) -->
        <Border Grid.RowSpan="2" Background="{StaticResource Rail}" BorderBrush="{StaticResource RowLine}" BorderThickness="0,0,1,0" Padding="16,0,16,24">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,14,0,28">
                    <Grid Width="28" Height="28">
                        <Ellipse Stroke="{StaticResource Accent}" StrokeThickness="2.5" StrokeDashArray="7.5 2.5"/>
                        <Ellipse Width="8" Height="8" Fill="{StaticResource Accent}"/>
                    </Grid>
                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontFamily="{StaticResource Display}" FontSize="18" FontWeight="Bold">
                        <Run Text="BCU"/><Run Text="/" Foreground="{StaticResource Accent}"/><Run Text="HOLO"/>
                    </TextBlock>
                </StackPanel>
                <Button x:Name="RescanButton" DockPanel.Dock="Bottom" Style="{StaticResource Ghost}" Click="Rescan_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Rescan"/>
                    </StackPanel>
                </Button>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Caps}" Text="Drives" Margin="10,0,0,10"/>
                <ListBox x:Name="DriveList" Background="Transparent" BorderThickness="0" SelectionChanged="Drive_Changed"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Drives">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="0,0,0,8"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="c" CornerRadius="12" BorderThickness="1" BorderBrush="Transparent" Background="Transparent" Padding="12,10">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="c" Property="Background" Value="#08FFFFFF"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="c" Property="Background" Value="{StaticResource AccentSoft}"/>
                                                <Setter TargetName="c" Property="BorderBrush" Value="#4D3DDCFF"/>
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="c" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" FontFamily="{StaticResource Mono}" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                                </DockPanel>
                                <Grid Height="4" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding UsedFill}"/>
                                        <ColumnDefinition Width="{Binding UsedRest}"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.ColumnSpan="2" CornerRadius="2" Background="{StaticResource Track}"/>
                                    <Border CornerRadius="2" Background="{Binding BarBrush}"/>
                                </Grid>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Caption buttons -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
            <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Min_Click" AutomationProperties.Name="Minimize"/>
            <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="Max_Click" AutomationProperties.Name="Maximize"/>
            <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="Close_Click" AutomationProperties.Name="Close"/>
        </StackPanel>

        <!-- Main -->
        <Grid Grid.Column="1" Grid.Row="1" Margin="32,4,32,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Overview cards -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="132" Height="132">
                            <Ellipse Stroke="{StaticResource Track}" StrokeThickness="12"/>
                            <!-- Dash units are multiples of StrokeThickness; set from code -->
                            <Ellipse x:Name="DriveRing" Stroke="{StaticResource Accent}" StrokeThickness="12"
                                     StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform><RotateTransform Angle="-90"/></Ellipse.RenderTransform>
                                <Ellipse.Effect><DropShadowEffect Color="#3DDCFF" BlurRadius="18" ShadowDepth="0" Opacity="0.55"/></Ellipse.Effect>
                            </Ellipse>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="DrivePct" Text="—" FontFamily="{StaticResource Display}" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock Text="used" Foreground="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel Margin="24,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="DriveLabel" Style="{StaticResource Caps}" Text="Local disk C:"/>
                            <TextBlock Margin="0,4,0,4" FontFamily="{StaticResource Display}" FontSize="34" FontWeight="Bold">
                                <Run x:Name="DriveFree" Text="—"/><Run Text=" free" FontSize="16" FontWeight="Normal" Foreground="{StaticResource Muted}"/>
                            </TextBlock>
                            <TextBlock x:Name="DriveUsed" FontFamily="{StaticResource Mono}" FontSize="13" Foreground="{StaticResource Muted}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="SplitTitle" Style="{StaticResource Caps}" Text="Where the used space went"/>
                        <Grid Height="14" Margin="0,14,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="SplitApps" Width="1*"/>
                                <ColumnDefinition Width="3"/>
                                <ColumnDefinition x:Name="SplitOther" Width="2*"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="{StaticResource Accent}" CornerRadius="7,0,0,7"/>
                            <Border Grid.Column="2" Background="{StaticResource Other}" CornerRadius="0,7,7,0"/>
                        </Grid>
                        <WrapPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,24,4">
                                <Border Width="10" Height="10" CornerRadius="3" Background="{StaticResource Accent}" Margin="0,0,8,0"/>
                                <TextBlock>Installed apps <Run x:Name="AppsTotal" FontFamily="{StaticResource Mono}" FontWeight="Bold" Text="—"/></TextBlock>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Width="10" Height="10" CornerRadius="3" Background="{StaticResource Other}" BorderBrush="#6B7FA0" BorderThickness="1" Margin="0,0,8,0"/>
                                <TextBlock>Files, caches, everything else <Run x:Name="OtherTotal" FontFamily="{StaticResource Mono}" FontWeight="Bold" Text="—"/></TextBlock>
                            </StackPanel>
                        </WrapPanel>
                        <TextBlock x:Name="SplitNote" Margin="0,6,0,0" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Toolbar -->
            <DockPanel Grid.Row="1" Margin="0,0,0,14">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Border CornerRadius="12" Background="#0DFFFFFF" BorderBrush="{StaticResource PanelLine}" BorderThickness="1" Width="280" Height="44" Padding="14,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock x:Name="SearchHint" Grid.Column="1" Text="Search apps, publishers…" Foreground="{StaticResource Muted}" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            <TextBox x:Name="SearchBox" Grid.Column="1" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Text}" CaretBrush="{StaticResource Accent}"
                                     VerticalAlignment="Center" FontSize="14" TextChanged="Search_Changed" AutomationProperties.Name="Search apps"/>
                        </Grid>
                    </Border>
                    <RadioButton x:Name="FilterAll" Style="{StaticResource Chip}" Content="All" IsChecked="True" GroupName="f" Checked="Filter_Changed"/>
                    <RadioButton x:Name="FilterLarge" Style="{StaticResource Chip}" Content="Over 1 GB" GroupName="f" Checked="Filter_Changed"/>
                    <RadioButton x:Name="FilterMs" Style="{StaticResource Chip}" Content="Microsoft" GroupName="f" Checked="Filter_Changed"/>
                    <RadioButton x:Name="FilterStore" Style="{StaticResource Chip}" Content="Store apps" GroupName="f" Checked="Filter_Changed"/>
                </StackPanel>
                <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource Display}" FontSize="26" FontWeight="Bold">
                    Installed apps <Run x:Name="ListCaption" FontSize="15" FontWeight="Normal" Foreground="{StaticResource Muted}" Text="· sorted by size"/>
                </TextBlock>
            </DockPanel>

            <!-- List -->
            <Border Grid.Row="2" CornerRadius="18,18,0,0" Background="#06FFFFFF" BorderBrush="{StaticResource RowLine}" BorderThickness="1,1,1,0">
                <ListBox x:Name="AppList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Text}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel" SelectionMode="Single" KeyDown="List_KeyDown"
                         AutomationProperties.Name="Installed apps">
                    <ListBox.Resources>
                        <!-- Thin glass scrollbar (vertical only; horizontal is disabled on this list) -->
                        <Style TargetType="ScrollBar">
                            <Setter Property="Width" Value="12"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ScrollBar">
                                        <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="0,8">
                                            <Track.DecreaseRepeatButton>
                                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                            </Track.DecreaseRepeatButton>
                                            <Track.IncreaseRepeatButton>
                                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                            </Track.IncreaseRepeatButton>
                                            <Track.Thumb>
                                                <Thumb>
                                                    <Thumb.Template>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Border x:Name="t" CornerRadius="3" Width="6" Background="#3378C8FF"/>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="t" Property="Background" Value="{StaticResource Accent}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Thumb.Template>
                                                </Thumb>
                                            </Track.Thumb>
                                        </Track>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.Resources>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="r" Background="Transparent" BorderBrush="{StaticResource RowLine}" BorderThickness="0,0,0,1">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="r" Property="Background" Value="#0F3DDCFF"/>
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter TargetName="r" Property="Background" Value="{StaticResource DangerSoft}"/>
                                            </DataTrigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="r" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                                <Setter TargetName="r" Property="BorderThickness" Value="1"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="60" Margin="20,0" Background="Transparent" MouseLeftButtonUp="Row_Click">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="54"/>
                                    <ColumnDefinition Width="2.2*"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="1.6*"/>
                                    <ColumnDefinition Width="96"/>
                                </Grid.ColumnDefinitions>
                                <!-- Custom checkbox: orange = marked for removal -->
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" Focusable="False" Cursor="Hand"
                                          AutomationProperties.Name="{Binding Name, StringFormat=Select {0}}">
                                    <CheckBox.Template>
                                        <ControlTemplate TargetType="CheckBox">
                                            <Border x:Name="box" Width="20" Height="20" CornerRadius="6" BorderThickness="1.5" BorderBrush="#5A6F8F" Background="Transparent">
                                                <Path x:Name="tick" Data="M3.5,9.5 L7.5,13.5 L15.5,5.5" Stroke="#1A0E04" StrokeThickness="2.2"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="box" Property="Background" Value="{StaticResource Danger}"/>
                                                    <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Danger}"/>
                                                    <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </CheckBox.Template>
                                </CheckBox>
                                <Border Grid.Column="1" Width="40" Height="40" CornerRadius="11" Background="{StaticResource Tile}" BorderBrush="#403DDCFF" BorderThickness="1" HorizontalAlignment="Left">
                                    <Grid>
                                        <TextBlock x:Name="ini" Visibility="Collapsed" Text="{Binding Initials}" FontFamily="{StaticResource Display}" FontWeight="Bold" Foreground="{StaticResource Accent}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Image Source="{Binding Icon}" Width="24" Height="24"/>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,14,0">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Publisher}" Foreground="{StaticResource Muted}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border CornerRadius="6" Background="{StaticResource AccentSoft}" Padding="7,3" Margin="0,0,6,0">
                                        <TextBlock Text="{Binding Drive}" FontFamily="{StaticResource Mono}" FontSize="12" Foreground="{StaticResource Accent}"/>
                                    </Border>
                                    <Border x:Name="kind" CornerRadius="999" Background="#0FFFFFFF" Padding="10,3">
                                        <TextBlock Text="{Binding Kind}" FontSize="12" Foreground="#C5D3E8"/>
                                    </Border>
                                </StackPanel>
                                <Grid Grid.Column="4" Height="8" VerticalAlignment="Center" Margin="0,0,14,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding BarFill}"/>
                                        <ColumnDefinition Width="{Binding BarRest}"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.ColumnSpan="2" CornerRadius="4" Background="{StaticResource Track}"/>
                                    <Border x:Name="bar" CornerRadius="4" Background="{StaticResource Accent}"/>
                                </Grid>
                                <TextBlock Grid.Column="5" Text="{Binding SizeText}" FontFamily="{StaticResource Mono}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                    <Setter TargetName="ini" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="{x:Null}">
                                    <Setter TargetName="kind" Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="bar" Property="Background" Value="{StaticResource Danger}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Scan progress -->
            <Border x:Name="ScanOverlay" Grid.Row="2" Background="#E6070B14" CornerRadius="18,18,0,0">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="420">
                    <TextBlock Text="Scanning installed apps…" FontFamily="{StaticResource Display}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <ProgressBar x:Name="ScanProgress" Height="4" Margin="0,18,0,10" Foreground="{StaticResource Accent}" Background="{StaticResource Track}" BorderThickness="0" IsIndeterminate="True"/>
                    <TextBlock x:Name="ScanStatus" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>

            <!-- Selection bar -->
            <Border x:Name="SelectionBar" Grid.Row="2" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,22"
                    Background="#EB0E1628" BorderBrush="#593DDCFF" BorderThickness="1" CornerRadius="18" Padding="24,14,16,14" Visibility="Collapsed">
                <Border.Effect><DropShadowEffect Color="Black" BlurRadius="40" ShadowDepth="10" Opacity="0.6"/></Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="SelCount" VerticalAlignment="Center" FontSize="15"/>
                    <TextBlock VerticalAlignment="Center" Margin="20,0" FontFamily="{StaticResource Display}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Accent}">
                        <Run x:Name="SelSize"/><Run Text=" reclaimable" FontSize="14" FontWeight="Normal" Foreground="{StaticResource Muted}"/>
                    </TextBlock>
                    <Button Style="{StaticResource Ghost}" Content="Clear" Click="Clear_Click" Margin="0,0,10,0"/>
                    <Button x:Name="UninstallButton" Style="{StaticResource Primary}" IsEnabled="False"
                            ToolTipService.ShowOnDisabled="True" ToolTip="Uninstall wiring is the next build step"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
    </Border>
</Window>
