<Window x:Class="BcuHolo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BCU Holo" Icon="/holo.ico" Width="1440" Height="900" MinWidth="980" MinHeight="620"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
    <!-- Custom dark chrome: our own caption bar + buttons, native resize/snap kept.
         Corners are rounded with a window region (see ApplyRoundRegion) because Windows 10 has no DWM corner option. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="8" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#14FFFFFF"/>
                                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#C42B1C"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Frame" BorderBrush="{DynamicResource GlassLine}" BorderThickness="1" CornerRadius="16" ClipToBounds="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="228"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Backdrop glows -->
        <Canvas Grid.ColumnSpan="2" Grid.RowSpan="2" IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse Canvas.Right="-260" Canvas.Top="-320" Width="900" Height="700">
                <Ellipse.Fill><RadialGradientBrush><GradientStop Color="{DynamicResource Accent.2E.C}" Offset="0"/><GradientStop Color="{DynamicResource Accent.00.C}" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
            </Ellipse>
            <Ellipse Canvas.Left="-200" Canvas.Bottom="-300" Width="900" Height="760">
                <Ellipse.Fill><RadialGradientBrush><GradientStop Color="{DynamicResource Violet.24.C}" Offset="0"/><GradientStop Color="{DynamicResource Violet.00.C}" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
            </Ellipse>
            <Ellipse Canvas.Left="700" Canvas.Top="380" Width="700" Height="520">
                <Ellipse.Fill><RadialGradientBrush><GradientStop Color="{DynamicResource Danger.14.C}" Offset="0"/><GradientStop Color="{DynamicResource Danger.00.C}" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
            </Ellipse>
        </Canvas>

        <!-- Tech doodles: dot grid, circuit traces, reticle, labels. Faint on purpose; purely decorative. -->
        <Grid Grid.Column="1" Grid.RowSpan="2" IsHitTestVisible="False" ClipToBounds="True" Opacity="0.45">
            <Rectangle>
                <Rectangle.Fill>
                    <DrawingBrush TileMode="Tile" Viewport="0,0,24,24" ViewportUnits="Absolute">
                        <DrawingBrush.Drawing>
                            <DrawingGroup>
                                <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0Z"/>
                                <GeometryDrawing Brush="{DynamicResource Line.24}" Geometry="M1,0 A1,1 0 1 1 1,2 A1,1 0 1 1 1,0Z"/>
                            </DrawingGroup>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Rectangle.Fill>
                <Rectangle.OpacityMask>
                    <RadialGradientBrush Center="0.7,0.3" RadiusX="0.9" RadiusY="0.9"><GradientStop Color="#FF000000" Offset="0"/><GradientStop Color="#40000000" Offset="1"/></RadialGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
            <Path Stroke="{DynamicResource Accent.29}" StrokeThickness="1.2" HorizontalAlignment="Left" VerticalAlignment="Top"
                  Data="M0,120 h60 l24,24 h140 l18,18 h120 M0,560 h40 l30,30 v120 l22,22 h180"/>
            <Path Stroke="{DynamicResource Accent.29}" StrokeThickness="1.2" HorizontalAlignment="Right" VerticalAlignment="Top"
                  Data="M300,300 h-70 l-24,24 v90 l-30,30 h-60 M300,140 h-120 l-20,-20 h-90"/>
            <Path Stroke="{DynamicResource Violet.2E}" StrokeThickness="1.2" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                  Data="M0,60 v-30 l18,-18 h120 l16,16 h150"/>
            <Path Stroke="#24FFFFFF" StrokeThickness="1.2" Fill="{DynamicResource Bg}" HorizontalAlignment="Left" VerticalAlignment="Top"
                  Data="M362,162 m-3.5,0 a3.5,3.5 0 1,0 7,0 a3.5,3.5 0 1,0 -7,0 M272,734 m-3.5,0 a3.5,3.5 0 1,0 7,0 a3.5,3.5 0 1,0 -7,0"/>
            <!-- reticle -->
            <Canvas HorizontalAlignment="Right" VerticalAlignment="Top" Width="260" Height="260" Margin="0,80,40,0">
                <Ellipse Width="220" Height="220" Canvas.Left="20" Canvas.Top="20" Stroke="{DynamicResource Accent.24}" StrokeDashArray="2 6"/>
                <Ellipse Width="156" Height="156" Canvas.Left="52" Canvas.Top="52" Stroke="{DynamicResource Accent.24}"/>
                <Ellipse Width="156" Height="156" Canvas.Left="52" Canvas.Top="52" Stroke="{DynamicResource Accent.55}" StrokeThickness="2" StrokeDashArray="20 225"/>
                <Ellipse Width="92" Height="92" Canvas.Left="84" Canvas.Top="84" Stroke="{DynamicResource Accent.24}" StrokeDashArray="10 5"/>
                <Path Stroke="{DynamicResource Accent.24}" Data="M0,130 h40 M220,130 h40 M130,0 v40 M130,220 v40"/>
                <Path Stroke="{DynamicResource Accent.5A}" Data="M124,130 h12 M130,124 v12"/>
            </Canvas>
        </Grid>

        <!-- Rail (spans the caption row; empty areas drag the window) -->
        <Border Grid.RowSpan="2" Background="{DynamicResource Rail.99}" BorderBrush="{DynamicResource GlassLine}" BorderThickness="0,0,1,0" Padding="14,0,14,20">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,14,0,24">
                    <Image Source="/holo.ico" Width="28" Height="28">
                        <Image.Effect><DropShadowEffect Color="{DynamicResource Accent.C}" BlurRadius="12" ShadowDepth="0" Opacity="0.7"/></Image.Effect>
                    </Image>
                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontFamily="{DynamicResource Display}" FontSize="18" FontWeight="Bold">
                        <Run Text="BCU"/><Run Text="/" Foreground="{DynamicResource Accent}"/><Run Text="HOLO"/>
                    </TextBlock>
                </StackPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="BCU.HOLO · NODE 07" FontFamily="{DynamicResource Mono}" FontSize="9" Foreground="{DynamicResource Muted.52}" Margin="8,10,0,0"/>
                <Border DockPanel.Dock="Bottom" CornerRadius="16" Background="{DynamicResource Good.12}" BorderBrush="{DynamicResource Good.40}" BorderThickness="1" Padding="12,10" Margin="4,12,4,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource Good}" Margin="0,0,8,0">
                                <Ellipse.Effect><DropShadowEffect Color="{DynamicResource Good.C}" BlurRadius="10" ShadowDepth="0"/></Ellipse.Effect>
                            </Ellipse>
                            <TextBlock Text="All local" Foreground="{DynamicResource Good}" FontWeight="SemiBold" FontSize="13"/>
                        </StackPanel>
                        <TextBlock Text="No telemetry. Nothing goes online unless you press a Check button." TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <UniformGrid DockPanel.Dock="Bottom" Columns="2" Margin="4,12,4,0">
                    <Button Style="{StaticResource Ghost}" Click="Theme_Click" Margin="0,0,4,0" MinHeight="40" Padding="8,0" AutomationProperties.Name="Theme picker" ToolTip="Change the colour theme">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE790;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock Text="Theme" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource Ghost}" Click="Widget_Click" Margin="4,0,0,0" MinHeight="40" Padding="8,0" AutomationProperties.Name="Widget toggle" ToolTip="Show or hide the desktop widget">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock Text="Widget" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                </UniformGrid>
                <ListBox x:Name="ModuleList" Background="Transparent" BorderThickness="0" SelectionChanged="Module_Changed"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Modules">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="0,0,0,4"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="c" CornerRadius="14" MinHeight="44" BorderThickness="1" BorderBrush="Transparent" Background="Transparent" Padding="12,0">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="c" Property="Background" Value="#0DFFFFFF"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                                                <Setter TargetName="c" Property="BorderBrush" Value="{DynamicResource Accent.59}"/>
                                                <Setter TargetName="c" Property="Background">
                                                    <Setter.Value>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                            <GradientStop Color="{DynamicResource Accent.38.C}" Offset="0"/><GradientStop Color="{DynamicResource Accent.0A.C}" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="c" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" Margin="0,0,12,0"
                                           Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"/>
                                <Border x:Name="badge" DockPanel.Dock="Right" CornerRadius="999" Background="{DynamicResource Danger.1F}" Padding="8,2">
                                    <TextBlock Text="{Binding Badge}" FontSize="11" Foreground="{DynamicResource Danger}"/>
                                </Border>
                                <TextBlock Text="{Binding Title}" FontSize="14" VerticalAlignment="Center" Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"/>
                            </DockPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Badge}" Value="{x:Null}">
                                    <Setter TargetName="badge" Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Caption: module title + window buttons -->
        <TextBlock x:Name="ModuleTitle" Grid.Column="1" Margin="32,10,0,0" FontFamily="{DynamicResource Display}" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
            <Button Style="{StaticResource CaptionButton}" Content="&#xE8A7;" Click="Widget_Click" AutomationProperties.Name="Widget" ToolTip="Desktop widget"/>
            <Button x:Name="ThemeButton" Style="{StaticResource CaptionButton}" Content="&#xE790;" Click="Theme_Click" AutomationProperties.Name="Theme" ToolTip="Theme"/>
            <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Min_Click" AutomationProperties.Name="Minimize"/>
            <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="Max_Click" AutomationProperties.Name="Maximize"/>
            <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="Close_Click" AutomationProperties.Name="Close"/>
        </StackPanel>

        <!-- Active module -->
        <ContentControl x:Name="ModuleHost" Grid.Column="1" Grid.Row="1" Margin="32,12,32,0" Focusable="False"/>
    </Grid>
    </Border>
</Window>
