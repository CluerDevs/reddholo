<UserControl x:Class="BcuHolo.Modules.Cleanup.CleanupView"
             xmlns:holo="clr-namespace:BcuHolo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource Text}">
    <Grid Margin="0,4,0,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Total of checked items -->
        <holo:GlassCard Style="{StaticResource Card}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource Caps}" Text="Reclaimable"/>
                    <TextBlock x:Name="TotalText" Margin="0,4,0,0" Text="…" FontFamily="{DynamicResource Display}" FontSize="40"
                               FontWeight="Bold" Foreground="{DynamicResource Danger}"/>
                </StackPanel>
                <TextBlock x:Name="CountText" Grid.Column="1" VerticalAlignment="Bottom" Foreground="{DynamicResource Muted}" FontSize="13"/>
            </Grid>
        </holo:GlassCard>

        <!-- Item cards -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
            <ItemsControl x:Name="ItemList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <holo:GlassCard Style="{StaticResource Card}" CornerRadius="18" Margin="0,0,0,12" Padding="20,16"
                                Visibility="{Binding ItemVisibility}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Visibility="{Binding CheckVisibility}"
                                          VerticalAlignment="Top" Margin="0,2,16,0" Cursor="Hand"
                                          AutomationProperties.Name="{Binding Name, StringFormat=Select {0}}">
                                    <CheckBox.Template>
                                        <ControlTemplate TargetType="CheckBox">
                                            <Border x:Name="box" Width="20" Height="20" CornerRadius="6" BorderThickness="1.5" BorderBrush="{DynamicResource Muted}" Background="Transparent">
                                                <Path x:Name="tick" Data="M3.5,9.5 L7.5,13.5 L15.5,5.5" Stroke="{DynamicResource OnDanger}" StrokeThickness="2.2"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="box" Property="Background" Value="{DynamicResource Danger}"/>
                                                    <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Danger}"/>
                                                    <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </CheckBox.Template>
                                </CheckBox>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Description}" Foreground="{DynamicResource Muted}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding Risk}" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" Opacity="0.8"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="20,0,0,0">
                                    <TextBlock Text="{Binding SizeText}" FontFamily="{DynamicResource Mono}" FontSize="15" HorizontalAlignment="Right"/>
                                    <Button Style="{StaticResource Ghost}" Content="Compact…" Click="Compact_Click" Margin="0,8,0,0"
                                            Visibility="{Binding CompactVisibility}" HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Grid>
                        </holo:GlassCard>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Result line and actions -->
        <Grid Grid.Row="2" Margin="0,4,0,0">
            <TextBlock x:Name="ResultText" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="4,0,16,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="RescanButton" Style="{StaticResource Ghost}" Content="Rescan sizes" Click="Rescan_Click" Margin="0,0,10,0"/>
                <Button x:Name="CleanButton" Style="{StaticResource Primary}" Content="Clean selected" Click="Clean_Click"/>
            </StackPanel>
        </Grid>

        <!-- Busy overlay, same look as the Apps scan overlay -->
        <Border x:Name="BusyOverlay" Grid.RowSpan="3" Background="{DynamicResource Bg.E6}" CornerRadius="18" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" Margin="60,0">
                <TextBlock x:Name="BusyTitle" FontFamily="{DynamicResource Display}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                <ProgressBar Height="4" Margin="0,18,0,0" Foreground="{DynamicResource Accent}" Background="{DynamicResource Track}"
                             BorderThickness="0" IsIndeterminate="True"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
