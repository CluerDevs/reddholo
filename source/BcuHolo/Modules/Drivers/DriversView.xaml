<UserControl x:Class="BcuHolo.Modules.Drivers.DriversView"
             xmlns:holo="clr-namespace:BcuHolo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource Text}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Graphics + platform -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <holo:GlassCard Style="{StaticResource Card}" Margin="0,4,8,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource Caps}" Text="Graphics"/>
                    <ItemsControl ItemsSource="{Binding Gpus}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,10,0,0">
                                    <TextBlock Text="{Binding DeviceName}" FontSize="16" FontFamily="{DynamicResource Display}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding VersionLine}" Foreground="{DynamicResource Accent}" FontFamily="{DynamicResource Mono}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Style="{StaticResource Ghost}" Content="NVIDIA drivers page" HorizontalAlignment="Left" Margin="0,14,0,0" Click="Nvidia_Click"/>
                </StackPanel>
            </holo:GlassCard>

            <holo:GlassCard Style="{StaticResource Card}" Grid.Column="1" Margin="8,4,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource Caps}" Text="Platform"/>
                    <TextBlock Text="{Binding BiosLine}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding BoardLine}" Foreground="{DynamicResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding CountText}" Foreground="{DynamicResource Muted}" Margin="0,10,0,0"/>
                    <WrapPanel Margin="-6,12,0,0">
                        <RadioButton Style="{StaticResource Chip}" GroupName="DriverFilter" Content="Third-party only" Tag="third" IsChecked="True" Click="Filter_Click"/>
                        <RadioButton Style="{StaticResource Chip}" GroupName="DriverFilter" Content="Show Microsoft drivers" Tag="all" Click="Filter_Click"/>
                    </WrapPanel>
                </StackPanel>
            </holo:GlassCard>
        </Grid>

        <!-- Windows Update -->
        <holo:GlassCard Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Style="{StaticResource Caps}" Text="Available from Windows Update"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Style="{StaticResource AccentGlass}" Content="Check for updates" IsEnabled="{Binding CanCheck}" Click="Check_Click"/>
                    <TextBlock Text="Contacts Windows Update only when pressed" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                    <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                </StackPanel>
                <TextBlock Text="{Binding EmptyText}" Foreground="{DynamicResource Good}" Margin="0,10,0,0"/>
                <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                    <ItemsControl ItemsSource="{Binding Updates}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,6,0,0">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="Open Windows Update" MinHeight="36" Margin="12,0,0,0" Click="OpenWu_Click"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource Muted}" FontSize="12"/>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </holo:GlassCard>

        <!-- Installed drivers -->
        <holo:GlassCard Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="20,16">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Caps}" Text="Installed drivers" Margin="0,0,0,10"/>
                <ListBox Foreground="{DynamicResource Text}" ItemsSource="{Binding Rows}" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"
                         AutomationProperties.Name="Installed drivers">
                    <ListBox.Resources>
                        <!-- Thin glass scrollbar (same as Apps) -->
                        <Style TargetType="ScrollBar">
                            <Setter Property="Width" Value="12"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ScrollBar">
                                        <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="0,8">
                                            <Track.DecreaseRepeatButton>
                                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                            </Track.DecreaseRepeatButton>
                                            <Track.IncreaseRepeatButton>
                                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                            </Track.IncreaseRepeatButton>
                                            <Track.Thumb>
                                                <Thumb>
                                                    <Thumb.Template>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Border x:Name="t" CornerRadius="3" Width="6" Background="{DynamicResource Line.33}"/>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="t" Property="Background" Value="{DynamicResource Accent}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Thumb.Template>
                                                </Thumb>
                                            </Track.Thumb>
                                        </Track>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.Resources>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding DeviceName}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Provider}" Foreground="{DynamicResource Muted}" FontSize="12"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding DeviceClass}" Foreground="{DynamicResource Muted}" FontFamily="{DynamicResource Mono}" FontSize="12"/>
                                <TextBlock Grid.Column="2" Text="{Binding Version}" FontFamily="{DynamicResource Mono}" FontSize="12"/>
                                <TextBlock Grid.Column="3" Text="{Binding Date}" FontFamily="{DynamicResource Mono}" FontSize="12"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </holo:GlassCard>
    </Grid>
</UserControl>
