<UserControl x:Class="BcuHolo.Modules.Startup.StartupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource Text}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,24">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="Refresh" VerticalAlignment="Center" Click="Refresh_Click"/>
                <StackPanel>
                    <TextBlock Style="{StaticResource Caps}" Text="STARTUP ITEMS"/>
                    <TextBlock Margin="0,4,0,0" FontFamily="{DynamicResource Display}" FontSize="30" FontWeight="Bold"><Run x:Name="CountOn" Text="…"/><Run x:Name="CountTotal" Foreground="{DynamicResource Muted}"/></TextBlock>
                    <TextBlock x:Name="LoadErrorText" Margin="0,6,0,0" Foreground="{DynamicResource Danger}" FontSize="13" TextWrapping="Wrap" Visibility="Collapsed"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Toolbar -->
        <DockPanel Grid.Row="1" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Border CornerRadius="12" Background="{DynamicResource GlassFill}" BorderBrush="{DynamicResource GlassLine}" BorderThickness="1" Width="210" Height="44" Padding="14,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock x:Name="SearchHint" Grid.Column="1" Text="Search name, publisher…" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <TextBox x:Name="SearchBox" Grid.Column="1" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Text}" CaretBrush="{DynamicResource Accent}"
                                 VerticalAlignment="Center" FontSize="14" TextChanged="Search_Changed" AutomationProperties.Name="Search startup items"/>
                    </Grid>
                </Border>
                <RadioButton x:Name="FilterAll" Style="{StaticResource Chip}" Content="All" IsChecked="True" GroupName="f" Checked="Filter_Changed"/>
                <RadioButton x:Name="FilterOn" Style="{StaticResource Chip}" Content="Enabled" GroupName="f" Checked="Filter_Changed"/>
                <RadioButton x:Name="FilterOff" Style="{StaticResource Chip}" Content="Disabled" GroupName="f" Checked="Filter_Changed"/>
                <RadioButton x:Name="FilterServices" Style="{StaticResource Chip}" Content="Services" GroupName="f" Checked="Filter_Changed"/>
                <RadioButton x:Name="FilterTasks" Style="{StaticResource Chip}" Content="Tasks" GroupName="f" Checked="Filter_Changed"/>
            </StackPanel>
        </DockPanel>

        <!-- List -->
        <Border Grid.Row="2" CornerRadius="18,18,0,0" Background="{DynamicResource GlassFill}" BorderBrush="{DynamicResource GlassLine}" BorderThickness="1,1,1,0">
            <Grid>
                <ListBox x:Name="ItemList" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Text}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel" AutomationProperties.Name="Startup items">
                    <ListBox.Resources>
                        <!-- Thin glass scrollbar (vertical only) -->
                        <Style TargetType="ScrollBar">
                            <Setter Property="Width" Value="12"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ScrollBar">
                                        <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="0,8">
                                            <Track.DecreaseRepeatButton>
                                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                            </Track.DecreaseRepeatButton>
                                            <Track.IncreaseRepeatButton>
                                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                            </Track.IncreaseRepeatButton>
                                            <Track.Thumb>
                                                <Thumb>
                                                    <Thumb.Template>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Border x:Name="t" CornerRadius="3" Width="6" Background="{DynamicResource Line.33}"/>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="t" Property="Background" Value="{DynamicResource Accent}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Thumb.Template>
                                                </Thumb>
                                            </Track.Thumb>
                                        </Track>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.Resources>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="r" Background="Transparent" BorderBrush="{DynamicResource RowLine}" BorderThickness="0,0,0,1">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="r" Property="Background" Value="{DynamicResource Accent.0F}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid x:Name="row" Height="60" Margin="20,0" Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="2.4*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="1.4*"/>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Icon, or initials when the file has none -->
                                <Border Width="40" Height="40" CornerRadius="11" Background="{DynamicResource Tile}" BorderBrush="{DynamicResource Accent.40}" BorderThickness="1" HorizontalAlignment="Left">
                                    <Grid>
                                        <TextBlock x:Name="ini" Visibility="Collapsed" Text="{Binding Initials}" FontFamily="{DynamicResource Display}" FontWeight="Bold" Foreground="{DynamicResource Accent}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Image Source="{Binding Icon}" Width="24" Height="24"/>
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,14,0">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Company}" Visibility="{Binding CompanyVisibility}" Foreground="{DynamicResource Muted}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Error}" Visibility="{Binding ErrorVisibility}" Foreground="{DynamicResource Danger}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <Border Grid.Column="2" CornerRadius="999" Background="#0FFFFFFF" Padding="10,3" Margin="0,0,14,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Kind}" FontSize="12" Foreground="{DynamicResource Text}"/>
                                </Border>

                                <TextBlock Grid.Column="3" Text="{Binding Location}" ToolTip="{Binding FullLocation}" FontFamily="{DynamicResource Mono}" FontSize="12" Foreground="{DynamicResource Muted}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,14,0"/>

                                <ToggleButton Grid.Column="4" IsChecked="{Binding Enabled, Mode=TwoWay}" Cursor="Hand" VerticalAlignment="Center"
                                              AutomationProperties.Name="{Binding Name, StringFormat=Toggle {0}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="track" Width="40" Height="22" CornerRadius="11" Background="{DynamicResource Track}"
                                                    BorderBrush="{DynamicResource GlassLine}" BorderThickness="1">
                                                <Ellipse x:Name="knob" Width="16" Height="16" Fill="White" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="track" Property="Background" Value="{DynamicResource Accent}"/>
                                                    <Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                    <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter TargetName="track" Property="BorderThickness" Value="2"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>

                                <Button Grid.Column="5" Width="32" Height="32" Margin="10,0,0,0" Cursor="Hand" Foreground="{DynamicResource Muted}" Background="Transparent"
                                        ToolTip="Delete entry (backup first)" AutomationProperties.Name="{Binding Name, StringFormat=Delete {0}}" Click="Delete_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="b" Background="Transparent" CornerRadius="8">
                                                <TextBlock x:Name="g" Text="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"
                                                           Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="g" Property="Foreground" Value="{DynamicResource Danger}"/>
                                                    <Setter TargetName="b" Property="Background" Value="{DynamicResource DangerSoft}"/>
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter TargetName="g" Property="Foreground" Value="{DynamicResource Danger}"/>
                                                    <Setter TargetName="b" Property="Background" Value="{DynamicResource DangerSoft}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                    <Setter TargetName="ini" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Enabled}" Value="False">
                                    <Setter TargetName="row" Property="Opacity" Value="0.55"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock x:Name="LoadingText" Text="Loading startup items…" FontFamily="{DynamicResource Display}" FontSize="18" Foreground="{DynamicResource Muted}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
