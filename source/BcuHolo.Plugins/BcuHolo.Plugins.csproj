		<OutputType>Library</OutputType>
		<UseWPF>true</UseWPF>
		<UseWindowsForms>false</UseWindowsForms>
		<Nullable>disable</Nullable>
		<ApplicationManifest />
	</PropertyGroup>
</Project>
